#!/bin/busybox sh
# PID 1 in the QEMU guest (see run.sh). Deliberately busybox-only (no real
# distro rootfs needed) — mounts pseudo-filesystems, loads the loop/fat/vfat
# kernel modules (not built into this host kernel), loop-attaches the
# baked-in GPT disk image (combined.img: PARTLABEL boot=ext4,
# EFI-SYSTEM=vfat), manually creates the /dev/disk/by-partlabel symlinks our
# production code resolves (no real udev running here), runs the harness
# binary (examples/qemu_harness.rs), and powers off. Everything printed
# here is captured via QEMU's serial console by run.sh.
#
# Deliberately NOT `set -e`: PID 1 exiting (for any reason, success or
# error) panics the kernel immediately, hiding diagnostics. Every step
# reports its own status; final pass/fail is the harness's own
# QEMU_HARNESS_RESULT marker line, checked by run.sh.
BB=/bin/busybox

$BB mount -t proc proc /proc
$BB mount -t sysfs sysfs /sys
$BB mount -t devtmpfs devtmpfs /dev

echo "=== rpi-bls-sync-rs QEMU loop-device harness: init starting ==="

$BB mkdir -p /dev/disk/by-partlabel /mnt/boot /mnt/efi

echo "--- loading loop/fat/vfat modules (not built-in on this kernel) ---"
$BB insmod /loop.ko
echo "insmod loop exit code: $?"
$BB insmod /fat.ko
echo "insmod fat exit code: $?"
$BB insmod /vfat.ko
echo "insmod vfat exit code: $?"

echo "--- attaching /combined.img via loop, partition-scanning ---"
$BB losetup -P -f /combined.img
echo "losetup exit code: $?"
LOOPDEV=$($BB losetup -a | $BB grep combined.img | $BB cut -d: -f1)
echo "loop device attached: $LOOPDEV"
$BB sleep 1

if [ -n "$LOOPDEV" ]; then
    $BB ln -sf "${LOOPDEV}p1" /dev/disk/by-partlabel/boot
    $BB ln -sf "${LOOPDEV}p2" /dev/disk/by-partlabel/EFI-SYSTEM
fi
echo "--- /dev/disk/by-partlabel ---"
$BB ls -la /dev/disk/by-partlabel/

echo "=== running qemu_harness ==="
LD_LIBRARY_PATH=/lib64 /bin/qemu_harness
echo "=== qemu_harness exited with code $? ==="

$BB sync
echo "=== powering off ==="
$BB poweroff -f
$BB sleep 5
echo "=== poweroff did not take, falling back to reboot ==="
$BB reboot -f
