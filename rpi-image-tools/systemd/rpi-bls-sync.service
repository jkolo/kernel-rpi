[Unit]
Description=Sync ostree BLS entry to /boot/efi/ (RPi direct-kernel boot)
Documentation=file:///usr/sbin/rpi-bls-sync.sh
RequiresMountsFor=/boot /boot/efi
ConditionPathIsDirectory=/proc/device-tree

[Service]
Type=oneshot
ExecStart=/usr/sbin/rpi-bls-sync.sh
StandardOutput=journal
StandardError=journal
