[Unit]
Description=BLS→EFI sync before shutdown/reboot (RPi direct-kernel boot)
DefaultDependencies=no
Before=final.target
Before=reboot.target
# DefaultDependencies=no usuwa domyślny ordering, więc gdy unit zostanie
# pociągnięty we wczesnej fazie bootu (hostname jeszcze localhost), /usr
# z ostree/composefs root NIE jest gotowy → ExecStart pada (binarka
# nieosiągalna, ENOENT/EACCES zależnie od stanu mountu). Wymuszamy gotowość
# rootfs: wtedy wczesne wywołanie albo czeka, albo robi idempotentny
# re-sync bieżącego BLS→EFI bez błędu. Sync przy shutdown działa jak dotąd.
After=local-fs.target
RequiresMountsFor=/usr
# Autorytatywnym punktem sync przy day-2 finalize jest ExecStopPost drop-inu
# ostree-finalize-staged (10-rpi-bls-sync.conf) — biegnie PO swapie boot.N,
# więc zapisuje poprawny slot. Ta jednostka to fallback. After= czyni tę
# kolejność jawną: gdy oba biegną przy shutdownie, ExecStopPost może domknąć
# stan po nas; a gdyby ta jednostka biegła po finalize, slot.rs (liveness-first,
# przypadek "shutdown-after-finalize") i tak utrzyma poprawny slot. Zero zmiany
# zachowania — zdejmuje dwuznaczność i chroni przed przyszłym regresem.
After=ostree-finalize-staged.service
ConditionPathIsDirectory=/proc/device-tree

[Service]
Type=oneshot
# Natywna binarka (rpi-bls-sync) — dawny 203/EXEC (mode-0644 initramfs
# copy + bash-wrapper defense-in-depth) jest nieaktualny: direct execve
# wymaga X_OK bez fallbacku, więc +x jest load-bearing w dwóch miejscach
# (rpi-image-tools.spec %attr ORAZ module-setup.sh chmod), nie tutaj.
ExecStart=/usr/sbin/rpi-bls-sync
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=final.target
WantedBy=reboot.target
